MONGODB_URI=mongodb://127.0.0.1:27017/medquora
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-private-password
CLIENT_URL=http://localhost:5173

# Optional: activate the patient doctor guide by configuring an n8n Webhook workflow.
N8N_DOCTOR_GUIDE_WEBHOOK_URL=
N8N_DOCTOR_GUIDE_TOKEN=
# Generate a private 64-character hex value for local n8n with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
